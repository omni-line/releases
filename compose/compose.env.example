# Omni Line Compose environment
# Copy to .env and adjust. Secrets are generated by install.sh when using the installer.

# Pin both app images to the same release (required for docs / upgrades).
OMNI_LINE_VERSION=0.1.0

# Image references (tag or digest). Prefer digests from image-digests.env when present:
#   OMNI_LINE_SERVER_IMAGE=ghcr.io/omni-line/omni-line-server@sha256:…
#   OMNI_LINE_CLIENT_IMAGE=ghcr.io/omni-line/omni-line-client@sha256:…
OMNI_LINE_SERVER_IMAGE=ghcr.io/omni-line/omni-line-server:0.1.0
OMNI_LINE_CLIENT_IMAGE=ghcr.io/omni-line/omni-line-client:0.1.0

# Docker Compose project name (scopes volume names). install.sh sets this from --dir.
# COMPOSE_PROJECT_NAME=omni-line

# Host port for the UI / reverse proxy
OMNI_LINE_PORT=8080

# Public URLs (must match how browsers and CLIs reach Omni Line)
SERVER_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Required secrets (install.sh generates URL-safe hex values)
# POSTGRES_PASSWORD must be URL-safe (avoid @ : / ? # in the password).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
POSTGRES_PASSWORD=change-me-postgres-password

POSTGRES_USER=omniline
POSTGRES_DB=omniline

# Bootstrap admin (created on first start when RUN_BOOTSTRAP_ON_START=true).
# No default organization is created — create one in the UI after sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@omni-line.local
BOOTSTRAP_ADMIN_PASSWORD=changeme123
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_CREATE_ORG=false
# Optional: only used when BOOTSTRAP_CREATE_ORG=true (local/dev) or as SSO JIT target slug.
# BOOTSTRAP_ORG_NAME=Default Organization
# BOOTSTRAP_ORG_SLUG=default

RUN_MIGRATIONS_ON_START=true
RUN_BOOTSTRAP_ON_START=true

# Artifact storage: fs (default volume) or s3
STORAGE_DRIVER=fs
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=

# SMTP (optional for eval; required for invites / password reset in production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Omni Line <no-reply@omni-line.local>

# Optional: override the vendor public key baked into the server image (rotation only)
# LICENSE_PUBLIC_KEY=
